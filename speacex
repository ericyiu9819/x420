#!/usr/bin/env bash
# Minimal single-hop VLESS over TCP/TLS for a server reached by an IPv4 address.
# Tunes kernel TCP/BBR, file limits, TLS 1.3, and TCP Fast Open for VPS throughput.
# Replaces /etc/sing-box/config.json after saving a timestamped backup.

set -Eeuo pipefail
umask 077

SERVER_IP="${1:-}"
PORT='443'
CONFIG='/etc/sing-box/config.json'
CERT_DIR='/etc/sing-box/certs'
CERT="${CERT_DIR}/vless-ip.crt"
KEY="${CERT_DIR}/vless-ip.key"
OUTPUT='/root/vless-client.txt'
SYSCTL_FILE='/etc/sysctl.d/99-speacex-network.conf'
SYSTEMD_DROPIN_DIR='/etc/systemd/system/sing-box.service.d'
SYSTEMD_DROPIN="${SYSTEMD_DROPIN_DIR}/10-network.conf"

[[ ${EUID} -eq 0 ]] || { echo 'Run as root.' >&2; exit 1; }
[[ "${SERVER_IP}" =~ ^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$ ]] \
  || { echo 'Usage: speacex SERVER_IPV4' >&2; exit 1; }

find_sing_box() {
  if command -v sing-box >/dev/null 2>&1; then
    command -v sing-box
    return
  fi
  local candidate
  for candidate in /usr/local/bin/sing-box /usr/bin/sing-box; do
    if [[ -x "${candidate}" ]]; then
      printf '%s' "${candidate}"
      return
    fi
  done
  return 1
}

install_sing_box() {
  if find_sing_box >/dev/null; then
    return
  fi
  command -v curl >/dev/null 2>&1 || { echo 'curl is required to install sing-box.' >&2; exit 1; }
  local installer
  installer="$(mktemp)"
  curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error \
    https://sing-box.app/install.sh -o "${installer}"
  sh "${installer}"
  rm -f "${installer}"
  find_sing_box >/dev/null || { echo 'sing-box install failed.' >&2; exit 1; }
}

ensure_user() {
  if ! getent group sing-box >/dev/null; then
    groupadd --system sing-box
  fi
  if ! id -u sing-box >/dev/null 2>&1; then
    useradd --system --no-create-home --gid sing-box --shell /usr/sbin/nologin sing-box
  fi
  install -d -o root -g sing-box -m 750 /etc/sing-box
}

ensure_unit() {
  local bin
  bin="$(find_sing_box)"
  if ! systemctl cat sing-box >/dev/null 2>&1; then
    cat >/etc/systemd/system/sing-box.service <<EOF
[Unit]
Description=sing-box service
After=network-online.target
Wants=network-online.target

[Service]
User=sing-box
Group=sing-box
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=${bin} -C /etc/sing-box run
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576
TasksMax=infinity

[Install]
WantedBy=multi-user.target
EOF
  fi
  install -d -m 755 "${SYSTEMD_DROPIN_DIR}"
  cat >"${SYSTEMD_DROPIN}" <<'EOF'
[Service]
LimitNOFILE=1048576
TasksMax=infinity
EOF
  systemctl daemon-reload
}

enable_tcp_tuning() {
  modprobe tcp_bbr >/dev/null 2>&1 || true
  cat >"${SYSCTL_FILE}" <<'EOF'
net.core.default_qdisc=fq
net.core.somaxconn=65535
net.core.netdev_max_backlog=16384
net.core.rmem_max=16777216
net.core.wmem_max=16777216
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_keepalive_time=60
net.ipv4.tcp_keepalive_intvl=15
net.ipv4.tcp_keepalive_probes=4
net.ipv4.tcp_max_syn_backlog=8192
net.ipv4.tcp_fin_timeout=15
net.ipv4.tcp_tw_reuse=1
net.ipv4.tcp_mtu_probing=1
net.ipv4.tcp_slow_start_after_idle=0
net.ipv4.ip_local_port_range=1024 65535
net.ipv4.tcp_rmem=4096 262144 16777216
net.ipv4.tcp_wmem=4096 65536 16777216
net.ipv4.tcp_notsent_lowat=16384
EOF
  if [[ -r /proc/sys/net/ipv4/tcp_available_congestion_control ]] \
    && grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control; then
    printf '\nnet.ipv4.tcp_congestion_control=bbr\n' >>"${SYSCTL_FILE}"
  fi
  # Apply each key so unsupported settings on a given kernel do not abort install.
  local line key value
  while IFS= read -r line; do
    [[ "${line}" =~ ^[[:space:]]*net\. ]] || continue
    key="${line%%=*}"
    value="${line#*=}"
    sysctl -w "${key}=${value}" >/dev/null 2>&1 || true
  done <"${SYSCTL_FILE}"
}

reuse_or_create_uuid() {
  local existing=''
  if [[ -f "${CONFIG}" ]]; then
    existing="$(sed -n 's/.*"uuid"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${CONFIG}" | head -n 1 || true)"
  fi
  if [[ "${existing}" =~ ^[0-9a-fA-F-]{36}$ ]]; then
    printf '%s' "${existing}"
  else
    cat /proc/sys/kernel/random/uuid
  fi
}

ensure_ecdsa_cert() {
  install -d -o root -g sing-box -m 750 "${CERT_DIR}"
  local recreate=1
  if [[ -f "${CERT}" && -f "${KEY}" ]]; then
    if openssl x509 -in "${CERT}" -noout -checkend 2592000 >/dev/null 2>&1 \
      && openssl x509 -in "${CERT}" -noout -ext subjectAltName 2>/dev/null | grep -q "IP Address:${SERVER_IP}"; then
      recreate=0
    fi
  fi
  if [[ "${recreate}" -eq 1 ]]; then
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -sha256 -nodes -days 825 \
      -keyout "${KEY}" \
      -out "${CERT}" \
      -subj "/CN=${SERVER_IP}" \
      -addext "subjectAltName=IP:${SERVER_IP}" \
      >/dev/null 2>&1
  fi
  chown root:sing-box "${CERT}" "${KEY}"
  chmod 640 "${CERT}" "${KEY}"
}

write_config() {
  local uuid="$1"
  local bin="$2"
  cat >"${CONFIG}" <<EOF
{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-tls-ip",
      "listen": "0.0.0.0",
      "listen_port": ${PORT},
      "tcp_fast_open": true,
      "tcp_keep_alive": "15s",
      "users": [
        {
          "uuid": "${uuid}"
        }
      ],
      "tls": {
        "enabled": true,
        "min_version": "1.3",
        "max_version": "1.3",
        "certificate_path": "${CERT}",
        "key_path": "${KEY}"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
EOF
  chown root:sing-box "${CONFIG}"
  chmod 640 "${CONFIG}"
  if ! "${bin}" check -c "${CONFIG}"; then
    echo 'sing-box rejected tcp_keep_alive; writing TFO-only inbound.' >&2
    cat >"${CONFIG}" <<EOF
{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-tls-ip",
      "listen": "0.0.0.0",
      "listen_port": ${PORT},
      "tcp_fast_open": true,
      "users": [
        {
          "uuid": "${uuid}"
        }
      ],
      "tls": {
        "enabled": true,
        "min_version": "1.3",
        "max_version": "1.3",
        "certificate_path": "${CERT}",
        "key_path": "${KEY}"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
EOF
    chown root:sing-box "${CONFIG}"
    chmod 640 "${CONFIG}"
    "${bin}" check -c "${CONFIG}"
  fi
}

install_sing_box
command -v openssl >/dev/null 2>&1 || { echo 'openssl is required.' >&2; exit 1; }
SING_BOX_BIN="$(find_sing_box)"
ensure_user
ensure_unit
enable_tcp_tuning

UUID="$(reuse_or_create_uuid)"
BACKUP="${CONFIG}.backup.$(date -u +%Y%m%dT%H%M%SZ)"
[[ -f "${CONFIG}" ]] && cp -a "${CONFIG}" "${BACKUP}"

ensure_ecdsa_cert
write_config "${UUID}" "${SING_BOX_BIN}"

systemctl enable sing-box
systemctl restart sing-box
systemctl is-active --quiet sing-box

if command -v ufw >/dev/null 2>&1 && ufw status | grep -q '^Status: active'; then
  ufw allow "${PORT}/tcp"
fi

URI="vless://${UUID}@${SERVER_IP}:${PORT}?encryption=none&security=tls&type=tcp&allowInsecure=1#minimal-vless-ip"
cat >"${OUTPUT}" <<EOF
${URI}

Server: ${SERVER_IP}
Port: ${PORT}
Protocol: VLESS
Transport: TCP Fast Open
Security: TLS 1.3 (self-signed ECDSA P-256 IP certificate)
UUID: ${UUID}
Client setting: allow insecure certificate = true
Kernel: BBR/fq when available, larger TCP buffers, no slow-start after idle
EOF
chmod 600 "${OUTPUT}"

echo "BACKUP=${BACKUP}"
echo "URI=${URI}"
echo "CONGESTION=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo unknown)"
echo "QDISC=$(sysctl -n net.core.default_qdisc 2>/dev/null || echo unknown)"
echo "TFO=$(sysctl -n net.ipv4.tcp_fastopen 2>/dev/null || echo unknown)"
echo "STATUS=active"
