#!/usr/bin/env bash
# Speed Vless
# VLESS + TCP + Reality 低冗余单主链路一键部署
# 默认握手目标：www.apple.com（稳定、快、TLS1.3）
# 用法：
#   bash Speed-Vless
#   PORT=443 HANDSHAKE_HOST=www.apple.com bash Speed-Vless
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
info(){ echo -e "${GREEN}[INFO]${NC} $*"; }
warn(){ echo -e "${YELLOW}[WARN]${NC} $*"; }
err(){ echo -e "${RED}[ERR]${NC} $*"; exit 1; }

[[ ${EUID} -eq 0 ]] || err "请使用 root 运行"

PORT="${PORT:-443}"
LISTEN="${LISTEN:-0.0.0.0}"
HANDSHAKE_HOST="${HANDSHAKE_HOST:-www.apple.com}"
HANDSHAKE_PORT="${HANDSHAKE_PORT:-443}"
SHORT_ID="${SHORT_ID:-}"
XRAY_DIR="/usr/local/etc/xray"
CONF_FILE="${XRAY_DIR}/config.json"
SHARE_FILE="/root/vless-reality-share.txt"

need_cmd(){ command -v "$1" >/dev/null 2>&1 || err "缺少命令: $1"; }

install_deps(){
  if command -v apt-get >/dev/null 2>&1; then
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y curl wget jq openssl ca-certificates unzip
  elif command -v yum >/dev/null 2>&1; then
    yum install -y curl wget jq openssl ca-certificates unzip
  elif command -v dnf >/dev/null 2>&1; then
    dnf install -y curl wget jq openssl ca-certificates unzip
  else
    err "不支持的包管理器，请手动安装 curl wget jq openssl unzip"
  fi
}

check_handshake(){
  info "检测握手目标: ${HANDSHAKE_HOST}:${HANDSHAKE_PORT}"
  if timeout 5 bash -c "</dev/tcp/${HANDSHAKE_HOST}/${HANDSHAKE_PORT}" 2>/dev/null; then
    info "握手目标可达"
  else
    warn "TCP 探测失败，请确认本机可访问该握手网址"
  fi
}

install_xray(){
  if command -v xray >/dev/null 2>&1; then
    info "已安装 Xray"
    return
  fi
  info "安装 Xray..."
  bash -c "$(curl -fsSL https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install
  need_cmd xray
}

gen_material(){
  UUID="$(xray uuid)"
  KEYS="$(xray x25519)"
  # 兼容 mawk（无 IGNORECASE）与新版输出 Password (PublicKey)
  PRIVATE_KEY="$(printf '%s\n' "$KEYS" | awk -F': ' 'tolower($1) ~ /private/ {gsub(/^[ \t]+|[ \t]+$/,"",$2); print $2; exit}')"
  PUBLIC_KEY="$(printf '%s\n' "$KEYS" | awk -F': ' 'tolower($1) ~ /public/ {gsub(/^[ \t]+|[ \t]+$/,"",$2); print $2; exit}')"
  if [[ -z "$PUBLIC_KEY" ]]; then
    PUBLIC_KEY="$(printf '%s\n' "$KEYS" | awk -F': ' 'tolower($1) ~ /password/ {gsub(/^[ \t]+|[ \t]+$/,"",$2); print $2; exit}')"
  fi
  PRIVATE_KEY="$(echo -n "$PRIVATE_KEY" | tr -d '\r')"
  PUBLIC_KEY="$(echo -n "$PUBLIC_KEY" | tr -d '\r')"
  [[ -n "$PRIVATE_KEY" && -n "$PUBLIC_KEY" ]] || err "生成 Reality 密钥失败:\n$KEYS"
  [[ -n "$SHORT_ID" ]] || SHORT_ID="$(openssl rand -hex 8)"
  SERVER_IP="$(curl -4 -fsSL --max-time 8 https://api.ipify.org || true)"
  [[ -n "$SERVER_IP" ]] || SERVER_IP="$(curl -4 -fsSL --max-time 8 https://ifconfig.me || true)"
  [[ -n "$SERVER_IP" ]] || SERVER_IP="YOUR_SERVER_IP"
}

write_config(){
  mkdir -p "$XRAY_DIR"
  cat > "$CONF_FILE" <<EOF
{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "listen": "${LISTEN}",
      "port": ${PORT},
      "protocol": "vless",
      "settings": {
        "clients": [ { "id": "${UUID}", "flow": "xtls-rprx-vision" } ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "${HANDSHAKE_HOST}:${HANDSHAKE_PORT}",
          "xver": 0,
          "serverNames": ["${HANDSHAKE_HOST}"],
          "privateKey": "${PRIVATE_KEY}",
          "shortIds": ["", "${SHORT_ID}"]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct",
      "settings": { "domainStrategy": "UseIPv4" }
    },
    { "protocol": "blackhole", "tag": "block" }
  ]
}
EOF
}

enable_bbr(){
  if sysctl net.ipv4.tcp_congestion_control 2>/dev/null | grep -q bbr; then
    info "BBR 已启用"
    return
  fi
  if modprobe tcp_bbr 2>/dev/null; then
    cat >/etc/sysctl.d/99-vless-bbr.conf <<'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF
    sysctl --system >/dev/null 2>&1 || sysctl -p >/dev/null 2>&1 || true
    info "已尝试启用 BBR"
  else
    warn "当前内核无法启用 BBR，跳过"
  fi
}

restart_xray(){
  systemctl enable xray >/dev/null 2>&1 || true
  systemctl restart xray
  sleep 1
  systemctl is-active --quiet xray || err "xray 启动失败: journalctl -u xray -n 50 --no-pager"
  info "xray 运行中"
}

print_share(){
  local link
  link="vless://${UUID}@${SERVER_IP}:${PORT}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${HANDSHAKE_HOST}&fp=chrome&pbk=${PUBLIC_KEY}&sid=${SHORT_ID}&type=tcp#vless-tcp-reality"
  cat > "$SHARE_FILE" <<EOF
======== VLESS TCP Reality ========
IP        : ${SERVER_IP}
Port      : ${PORT}
UUID      : ${UUID}
Flow      : xtls-rprx-vision
Network   : tcp
Security  : reality
Handshake : ${HANDSHAKE_HOST}
SNI       : ${HANDSHAKE_HOST}
PublicKey : ${PUBLIC_KEY}
ShortId   : ${SHORT_ID}
PrivateKey: ${PRIVATE_KEY}

Link:
${link}

Config: ${CONF_FILE}
===================================
EOF
  echo
  cat "$SHARE_FILE"
}

main(){
  info "部署 VLESS + TCP + Reality（低冗余单主链路）"
  info "握手网址: ${HANDSHAKE_HOST}:${HANDSHAKE_PORT}"
  install_deps
  need_cmd curl
  need_cmd openssl
  check_handshake
  install_xray
  gen_material
  write_config
  enable_bbr
  restart_xray
  print_share
  info "完成：导入分享链接即可上网"
}

main "$@"

