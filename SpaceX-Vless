#!/usr/bin/env bash
# 在 Ubuntu 22.04+ / Debian 12+ 的 systemd VPS 上安装单机 VLESS + REALITY + Vision。
# 同时启用当前内核的原版 BBR 和 fq。
# 用法：sudo bash <脚本路径> <VPS 公网 IP>
set -Eeuo pipefail
umask 077

fail() {
  printf '错误：%s\n' "$*" >&2
  exit 1
}

usage() {
  printf '用法：sudo bash %s <VPS 公网 IPv4 或 IPv6>\n' "${0##*/}"
}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  usage
  exit 0
fi
(( $# == 1 )) || { usage >&2; exit 2; }
(( EUID == 0 )) || fail '请在 VPS 上用 sudo 运行。'
[[ -r /etc/os-release ]] || fail '需要 Ubuntu 或 Debian。'
source /etc/os-release
[[ $ID == ubuntu || $ID == debian ]] || fail '需要 Ubuntu 或 Debian。'
[[ -d /run/systemd/system ]] || fail '需要正在运行的 systemd。'

for command in curl openssl python3 sha256sum unzip ss flock timeout ip tc modprobe sysctl; do
  command -v "$command" >/dev/null ||
    fail '请先运行 sudo apt-get install -y ca-certificates curl openssl python3 unzip iproute2 util-linux coreutils kmod procps。'
done

case "$(uname -m)" in
  x86_64) asset=Xray-linux-64.zip ;;
  aarch64|arm64) asset=Xray-linux-arm64-v8a.zip ;;
  *) fail '支持 x86_64 和 arm64。' ;;
esac

if ! node_address=$(python3 - "$1" <<'PY'
import ipaddress
import sys
from urllib.parse import quote

try:
    address = ipaddress.ip_address(sys.argv[1])
except ValueError:
    raise SystemExit(1)
if not address.is_global or address.is_multicast or getattr(address, "scope_id", None):
    raise SystemExit(1)
endpoint = f"[{address}]" if address.version == 6 else str(address)
print(endpoint, quote(str(address), safe=""))
PY
); then
  fail '请填 VPS 的公网 IP。IPv6 输入时无需加方括号。'
fi
read -r endpoint node_name <<<"$node_address"
bind_address=0.0.0.0
[[ $endpoint != \[* ]] || bind_address=::

target=www.tesla.com
service=xray-vless-reality.service
service_path=/etc/systemd/system/$service
install_dir=/opt/xray-vless-reality

exec 9>/run/lock/xray-vless-reality-install.lock
flock -n 9 || fail '已有安装任务正在运行。'
if [[ -e $install_dir || -L $install_dir || -e $service_path || -L $service_path ]] ||
   systemctl cat "$service" >/dev/null 2>&1; then
  fail "检测到已有安装。已安装节点的链接保存在 $install_dir/client-uri.txt。"
fi
[[ -z $(ss -H -ltn 'sport = :443') ]] ||
  fail 'TCP 443 已被占用。请先检查 sudo ss -ltnp。'

tmp_dir=$(mktemp -d)
created_dir=0
created_unit=0
network_settings_changed=0
added_network_configs=()
installed=0
cleanup() {
  local status=$?
  local path
  if (( ! installed )); then
    if (( network_settings_changed )); then
      sysctl -q -w "net.core.default_qdisc=$previous_qdisc" \
        "net.ipv4.tcp_congestion_control=$previous_cc" || true
    fi
    for path in "${added_network_configs[@]}"; do
      rm -f -- "$path"
    done
    if (( created_unit )); then
      systemctl disable --now "$service" >/dev/null 2>&1 || true
      rm -f -- "$service_path"
      systemctl daemon-reload || true
    fi
    if (( created_dir )); then
      rm -rf -- "$install_dir"
    fi
  fi
  rm -rf -- "$tmp_dir"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

network_configs=(
  /etc/modules-load.d/90-bbr-fq.conf
  /etc/sysctl.d/99-z-bbr-fq.conf
)
printf '%s\n' tcp_bbr sch_fq > "$tmp_dir/90-bbr-fq.conf"
printf '%s\n' 'net.core.default_qdisc = fq' 'net.ipv4.tcp_congestion_control = bbr' \
  > "$tmp_dir/99-z-bbr-fq.conf"
for path in "${network_configs[@]}"; do
  if [[ -e $path || -L $path ]]; then
    cmp -s "$tmp_dir/${path##*/}" "$path" ||
      fail "已有内容不同的配置文件：$path。"
  fi
done
modprobe tcp_bbr || fail '当前内核无法加载原版 tcp_bbr。'
modprobe sch_fq || fail '当前内核无法加载 sch_fq。'

printf '检查 %s 的证书、TLS 1.3 和 HTTP/2…\n' "$target"
if ! timeout 20 openssl s_client -connect "$target:443" -servername "$target" \
    -verify_hostname "$target" -verify_return_error -tls1_3 -alpn h2 \
    </dev/null >"$tmp_dir/tls-check.txt" 2>&1; then
  tail -n 12 "$tmp_dir/tls-check.txt" >&2
  fail '目标站点 TLS 检查失败，请检查 VPS 的 DNS、网络和 CA 证书。'
fi
grep -Fxq 'ALPN protocol: h2' "$tmp_dir/tls-check.txt" ||
  fail '从这台 VPS 连接时，目标站点没有协商 HTTP/2。'

download=(curl --disable --fail --silent --show-error --location --proto '=https'
          --connect-timeout 10 --max-time 120 --retry 2)
printf '下载并校验 Xray 官方稳定版…\n'
"${download[@]}" https://api.github.com/repos/XTLS/Xray-core/releases/latest \
  -o "$tmp_dir/release.json"
release_data=$(python3 - "$tmp_dir/release.json" "$asset" <<'PY'
import json
import re
import sys

with open(sys.argv[1], encoding="utf-8") as source:
    release = json.load(source)
tag = release["tag_name"]
if not re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+", tag):
    raise SystemExit("Xray 发行版标签格式异常")
for asset in release["assets"]:
    if asset["name"] == sys.argv[2]:
        digest = asset.get("digest") or ""
        if re.fullmatch(r"sha256:[a-f0-9]{64}", digest):
            print(tag, digest.removeprefix("sha256:"))
            break
else:
    raise SystemExit("发行版缺少对应平台的安装包或 SHA-256")
PY
)
read -r version digest <<<"$release_data"
"${download[@]}" "https://github.com/XTLS/Xray-core/releases/download/$version/$asset" \
  -o "$tmp_dir/$asset"
(cd "$tmp_dir" && printf '%s  %s\n' "$digest" "$asset" | sha256sum -c -)
unzip -q "$tmp_dir/$asset" xray -d "$tmp_dir"
chmod 0755 "$tmp_dir/xray"

uuid=$("$tmp_dir/xray" uuid)
keypair=$("$tmp_dir/xray" x25519)
private_key=$(awk -F ': ' '$1 == "PrivateKey" {print $2}' <<<"$keypair")
public_key=$(awk -F ': ' '$1 == "Password (PublicKey)" || $1 == "PublicKey" || $1 == "Password" {print $2}' <<<"$keypair")
short_id=$(openssl rand -hex 8)
[[ $private_key =~ ^[A-Za-z0-9_-]{43}$ && $public_key =~ ^[A-Za-z0-9_-]{43}$ ]] ||
  fail '无法读取 Xray 生成的 REALITY 密钥。'
[[ $uuid =~ ^[0-9a-fA-F-]{36}$ && $short_id =~ ^[0-9a-f]{16}$ ]] ||
  fail 'Xray UUID 或 Short ID 生成失败。'

cat > "$tmp_dir/config.json" <<JSON
{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "listen": "$bind_address",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "$uuid", "flow": "xtls-rprx-vision" }],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "target": "$target:443",
          "serverNames": ["$target"],
          "privateKey": "$private_key",
          "shortIds": ["$short_id"]
        }
      }
    }
  ],
  "outbounds": [{ "protocol": "freedom" }]
}
JSON
unset keypair private_key
"$tmp_dir/xray" run -test -config "$tmp_dir/config.json"

printf 'vless://%s@%s:443?encryption=none&security=reality&type=tcp&sni=%s&fp=chrome&pbk=%s&sid=%s&flow=xtls-rprx-vision#%s\n' \
  "$uuid" "$endpoint" "$target" "$public_key" "$short_id" "$node_name" > "$tmp_dir/client-uri.txt"

cat > "$tmp_dir/$service" <<'UNIT'
[Unit]
Description=Xray VLESS REALITY
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
DynamicUser=yes
LoadCredential=config.json:/opt/xray-vless-reality/config.json
ExecStart=/opt/xray-vless-reality/xray run -config ${CREDENTIALS_DIRECTORY}/config.json
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
UNIT

mkdir -m 0755 -- "$install_dir"
created_dir=1
install -m 0755 "$tmp_dir/xray" "$install_dir/xray"
install -m 0600 "$tmp_dir/config.json" "$install_dir/config.json"
install -m 0600 "$tmp_dir/client-uri.txt" "$install_dir/client-uri.txt"
# noclobber 防止在检查与安装之间覆盖同名服务。
(set -o noclobber; cat "$tmp_dir/$service" > "$service_path")
created_unit=1
chmod 0644 "$service_path"
systemctl daemon-reload

if ! systemctl start "$service"; then
  journalctl -u "$service" -n 15 --no-pager >&2 || true
  fail 'Xray 启动失败。'
fi
pid=$(systemctl show --property=MainPID --value "$service")
listening=0
for (( attempt = 0; attempt < 30; attempt++ )); do
  if [[ $pid =~ ^[1-9][0-9]*$ ]] &&
     ss -H -ltnp 'sport = :443' | grep -F "pid=$pid," >/dev/null; then
    listening=1
    break
  fi
  sleep 0.2
done
if (( ! listening )); then
  journalctl -u "$service" -n 15 --no-pager >&2 || true
  fail 'Xray 未成功监听 TCP 443。'
fi
systemctl enable "$service"

printf '启用原版 BBR 和 fq…\n'
previous_qdisc=$(sysctl -n net.core.default_qdisc)
previous_cc=$(sysctl -n net.ipv4.tcp_congestion_control)
for path in "${network_configs[@]}"; do
  if [[ ! -e $path && ! -L $path ]]; then
    (umask 022; set -o noclobber; cat "$tmp_dir/${path##*/}" > "$path")
    added_network_configs+=("$path")
  fi
done
network_settings_changed=1
sysctl -q -w net.core.default_qdisc=fq net.ipv4.tcp_congestion_control=bbr
[[ $(sysctl -n net.core.default_qdisc) == fq &&
   $(sysctl -n net.ipv4.tcp_congestion_control) == bbr ]] ||
  fail '内核未应用 BBR 和 fq。'

# default_qdisc 不会替换已启用接口上的队列。只更新出站接口的普通默认根队列。
route_probe=1.1.1.1
[[ $bind_address != :: ]] || route_probe=2606:4700:4700::1111
egress_device=$(ip -o route get "$route_probe" 2>/dev/null |
  awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}') ||
  egress_device=
if [[ -n $egress_device ]]; then
  root_queue=$(tc qdisc show dev "$egress_device" |
    awk '$1 == "qdisc" && $4 == "root" { print $2, $3 }')
  case "$root_queue" in
    'fq '*)
      ;;
    'fq_codel 0:'|'pfifo_fast 0:'|'pfifo 0:'|'codel 0:'|'sfq 0:')
      tc qdisc replace dev "$egress_device" root fq ||
        fail "无法将 $egress_device 的默认队列切换为 fq。"
      ;;
    *)
      printf '当前保留 %s 的队列 %s。新建默认队列使用 fq。\n' "$egress_device" "$root_queue"
      ;;
  esac
fi
installed=1

printf '\n已部署 Xray %s，REALITY 目标为 %s。\n' "$version" "$target"
printf '内核默认拥塞控制为 bbr，默认队列为 fq，已写入开机配置。\n'
printf '请确认云安全组和系统防火墙允许 TCP 443 入站。\n'
printf '客户端导入链接如下。该链接包含连接凭据，请私下保存。\n\n'
cat "$install_dir/client-uri.txt"
