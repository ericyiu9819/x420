[Unit]
Description=VPS proxy network queue tuning
Documentation=https://www.kernel.org/doc/html/latest/networking/
After=network-online.target
Wants=network-online.target
Before=xray.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vps-queuectl apply --profile auto
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
